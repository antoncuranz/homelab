{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":automergeMinor"
  ],
  "dependencyDashboard": {
    "title": "Renovate Dashboard 🤖"
  },
  "commitMessageExtra": "from {{{displayFrom}}} to {{{displayTo}}}",
  "packageRules": [
    {
      "matchPackageNames": [
        "/^ghcr\\.io\\/linuxserver\\//"
      ],
      "versioning": "regex:^(?<compatibility>.*?)-(?<major>v?\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)[\\.-]*(?<build>r?\\d+)*$"
    },
    {
      "matchPackageNames": [
        "immich-app/immich",
        "immich-app",
        "immich"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Own images are pinned by digest; deploy new builds automatically once lint passes",
      "matchPackageNames": [
        "ghcr.io/antoncuranz/**",
        "registry.gitlab.com/antoncuranz/**"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "`# renovate: datasource=... depName=... [versioning=...] [registryUrl=...]` comments",
      "managerFilePatterns": [
        "/.+\\.ya?ml$/",
        "/\\.ya?ml.j2$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?( registryUrl=(?<registryUrl>\\S+))?\n.*?\"(?<currentValue>.*)\"\n",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?-\\s(.*?)/(?<currentValue>[^/]+)/[^/]+\n",
        "datasource=(?<datasource>\\S+)\n.*?repo: (?<registryUrl>\\S+)\n.*?chart: (?<depName>\\S+)\n.*?version: (?<currentValue>\\S+)\n"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.ya?ml.j2$/"
    ]
  },
  "gomod": {
    "enabled": false
  },
  "terraform": {
    "enabled": false
  },
  "ansible-galaxy": {
    "enabled": false
  }
}
